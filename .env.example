# Copie para .env e ajuste conforme necessário: cp .env.example .env

# --- HTTP server ---
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# --- Banco de dados (Postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pgsim
DB_PASSWORD=pgsim
DB_NAME=pgsim
DB_SSLMODE=disable

# --- Observabilidade ---
# Formato de log: json (produção) ou text (desenvolvimento)
LOG_FORMAT=text
# Nível: debug, info, warn, error
LOG_LEVEL=info

# Ambiente: development ou production
APP_ENV=development
